# Copy to .env and fill in real values. Never commit the real .env file.

TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://user:password@host:5432/dbname
OTP_HASH_SECRET=

# Optional
ADMIN_TELEGRAM_IDS=
LOG_LEVEL=INFO

# SMS gateway (SMSEthiopia). Leave unset / SMS_MOCK_MODE=true to log codes
# instead of sending real SMS.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_MOCK_MODE=false

# Phone normalization / OTP tuning (defaults shown)
DEFAULT_COUNTRY_CODE=251
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=3
