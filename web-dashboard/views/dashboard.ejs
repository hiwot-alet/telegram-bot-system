<%
/**
 * Status-pill class helpers. Kept in sync with TONE_CLASSES / TONE_DOT_CLASSES
 * in the client-side <script> below, which renders the exact same shape of
 * row for live SSE updates — both must map { verified, failed, pending, info }
 * to the same colors (emerald / red / amber / slate) in both light and dark
 * mode, or live rows will visibly mismatch the ones rendered on page load.
 */
function toneClasses(tone) {
  switch (tone) {
    case 'verified': return 'bg-emerald-500/10 text-emerald-600 ring-emerald-500/20 dark:text-emerald-400';
    case 'failed': return 'bg-red-500/10 text-red-600 ring-red-500/20 dark:text-red-400';
    case 'pending': return 'bg-amber-500/10 text-amber-600 ring-amber-500/20 dark:text-amber-400';
    default: return 'bg-slate-500/10 text-slate-600 ring-slate-500/20 dark:text-slate-300';
  }
}
function toneDotClasses(tone) {
  switch (tone) {
    case 'verified': return 'bg-emerald-500 dark:bg-emerald-400';
    case 'failed': return 'bg-red-500 dark:bg-red-400';
    case 'pending': return 'bg-amber-500 dark:bg-amber-400';
    default: return 'bg-slate-400';
  }
}
// Ethiopia has one timezone, UTC+3, no DST — every timestamp on this page is
// shown in East Africa Time, matching server.js's formatEAT() used in exports.
function formatEAT(dateLike) {
  return new Date(dateLike)
    .toLocaleString('en-GB', {
      timeZone: 'Africa/Addis_Ababa',
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false,
    })
    .replace(',', '');
}
%>
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verification Dashboard — Telegram OTP System</title>
  <script>
    // Set the theme class before Tailwind (and the rest of the page) renders,
    // so there's no flash of the wrong theme on load. Falls back to the OS
    // preference the first time a visitor shows up (no stored choice yet).
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var theme = stored === 'light' || stored === 'dark'
          ? stored
          : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      } catch (e) {}
    })();
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            chrome: {
              plane: '#0d0d0d',
              surface: '#1a1a19',
              primary: '#ffffff',
              secondary: '#c3c2b7',
              muted: '#898781',
            },
          },
        },
      },
    };
  </script>
  <style>
    .tabular { font-variant-numeric: tabular-nums; }
    @keyframes row-flash {
      0% { background-color: rgba(52, 211, 153, 0.16); }
      100% { background-color: transparent; }
    }
    .row-flash { animation: row-flash 1.8s ease-out; }
  </style>
</head>
<body class="h-full bg-slate-50 text-slate-900 antialiased dark:bg-chrome-plane dark:text-chrome-primary">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Header -->
    <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold text-slate-900 dark:text-chrome-primary">Promoter Verification Dashboard</h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-chrome-secondary">Live verification activity across all campaigns.</p>
      </div>
      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle color theme"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white text-slate-600 ring-1 ring-inset ring-slate-200 hover:bg-slate-100 dark:bg-chrome-surface dark:text-chrome-secondary dark:ring-white/10 dark:hover:bg-white/5"
        >
          <svg id="theme-icon-sun" class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg id="theme-icon-moon" class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
        </button>
        <span id="connection-indicator" class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1.5 text-xs font-medium text-slate-500 ring-1 ring-inset ring-slate-200 dark:bg-chrome-surface dark:text-chrome-secondary dark:ring-white/10">
          <span id="connection-dot" class="h-2 w-2 rounded-full bg-slate-400 dark:bg-chrome-muted"></span>
          <span id="connection-label">Connecting…</span>
        </span>
        <a
          href="/api/reports/csv"
          class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-medium text-slate-900 ring-1 ring-inset ring-slate-200 hover:bg-slate-100 dark:bg-chrome-surface dark:text-chrome-primary dark:ring-white/10 dark:hover:bg-white/5"
        >
          Export Promoters CSV
        </a>
        <a
          href="/api/reports/customers/csv"
          class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-medium text-slate-900 ring-1 ring-inset ring-slate-200 hover:bg-slate-100 dark:bg-chrome-surface dark:text-chrome-primary dark:ring-white/10 dark:hover:bg-white/5"
        >
          Export Customers CSV
        </a>
        <a
          href="/api/reports/customers/xlsx"
          class="inline-flex items-center gap-2 rounded-md bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-500"
        >
          Export Customers Excel
        </a>
        <form method="POST" action="/logout">
          <button
            type="submit"
            class="inline-flex items-center gap-2 rounded-md bg-white px-3 py-2 text-sm font-medium text-slate-900 ring-1 ring-inset ring-slate-200 hover:bg-slate-100 dark:bg-chrome-surface dark:text-chrome-primary dark:ring-white/10 dark:hover:bg-white/5"
          >
            Sign out
          </button>
        </form>
      </div>
    </header>

    <!-- Stat cards -->
    <section class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg bg-white p-5 ring-1 ring-inset ring-slate-200 dark:bg-chrome-surface dark:ring-white/10">
        <p class="text-sm text-slate-500 dark:text-chrome-secondary">Total requests</p>
        <p id="stat-total" class="mt-2 text-3xl font-semibold text-slate-900 dark:text-chrome-primary"><%= Number(stats.total_requests || 0).toLocaleString() %></p>
      </div>
      <div class="rounded-lg bg-white p-5 ring-1 ring-inset ring-slate-200 dark:bg-chrome-surface dark:ring-white/10">
        <p class="text-sm text-slate-500 dark:text-chrome-secondary">Verified promoters</p>
        <p id="stat-verified" class="mt-2 text-3xl font-semibold text-emerald-600 dark:text-emerald-400"><%= Number(stats.verified_promoters || 0).toLocaleString() %></p>
      </div>
      <div class="rounded-lg bg-white p-5 ring-1 ring-inset ring-slate-200 dark:bg-chrome-surface dark:ring-white/10">
        <p class="text-sm text-slate-500 dark:text-chrome-secondary">Failed OTPs</p>
        <p id="stat-failed" class="mt-2 text-3xl font-semibold text-red-600 dark:text-red-400"><%= Number(stats.failed_otps || 0).toLocaleString() %></p>
      </div>
      <div class="rounded-lg bg-white p-5 ring-1 ring-inset ring-slate-200 dark:bg-chrome-surface dark:ring-white/10">
        <p class="text-sm text-slate-500 dark:text-chrome-secondary">Verified customers</p>
        <p id="stat-customers" class="mt-2 text-3xl font-semibold text-emerald-600 dark:text-emerald-400"><%= Number(stats.verified_customers || 0).toLocaleString() %></p>
      </div>
    </section>

    <!-- Promoter leaderboard: how many customers each promoter has registered -->
    <section class="mb-8 overflow-hidden rounded-lg bg-white ring-1 ring-inset ring-slate-200 dark:bg-chrome-surface dark:ring-white/10">
      <div class="border-b border-slate-200 px-4 py-3 dark:border-white/10">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-chrome-primary">Customers registered per promoter</h2>
        <p class="mt-0.5 text-xs text-slate-400 dark:text-chrome-muted">Sorted by verified customers. Download a promoter's full customer list as Excel.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
          <thead class="bg-slate-50 dark:bg-white/5">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Promoter</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">City</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Campaign</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Customers contacted</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Customers verified</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">List</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-sm dark:divide-white/5">
            <% promoterLeaderboard.forEach(function (row) { %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-slate-900 dark:text-chrome-primary"><%= row.full_name || row.telegram_username || ('Promoter #' + row.id) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary"><%= row.city || '—' %></td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary"><%= row.campaign_name || '—' %></td>
                <td class="tabular whitespace-nowrap px-4 py-3 text-right text-slate-500 dark:text-chrome-secondary"><%= row.customers_contacted %></td>
                <td class="tabular whitespace-nowrap px-4 py-3 text-right text-emerald-600 dark:text-emerald-400"><%= row.customers_verified %></td>
                <td class="whitespace-nowrap px-4 py-3">
                  <a href="/api/promoters/<%= row.id %>/customers/xlsx" class="text-xs font-medium text-slate-900 underline decoration-slate-300 hover:decoration-slate-500 dark:text-chrome-primary dark:decoration-white/30 dark:hover:decoration-white/70">
                    Download Excel
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (promoterLeaderboard.length === 0) { %>
        <p class="px-4 py-8 text-center text-sm text-slate-400 dark:text-chrome-muted">No promoter has registered any customers yet.</p>
      <% } %>
    </section>

    <!-- Filters -->
    <section class="mb-4 flex flex-wrap items-center gap-3">
      <input
        id="search-input"
        type="text"
        placeholder="Search by name, phone, campaign…"
        class="w-full max-w-sm rounded-md border-0 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 ring-1 ring-inset ring-slate-200 focus:ring-2 focus:ring-inset focus:ring-emerald-500 focus:outline-none dark:bg-chrome-surface dark:text-chrome-primary dark:placeholder:text-chrome-muted dark:ring-white/10"
      />
      <select
        id="status-filter"
        class="rounded-md border-0 bg-white px-3 py-2 text-sm text-slate-900 ring-1 ring-inset ring-slate-200 focus:ring-2 focus:ring-inset focus:ring-emerald-500 focus:outline-none dark:bg-chrome-surface dark:text-chrome-primary dark:ring-white/10"
      >
        <option value="">All statuses</option>
        <option value="verified">Verified</option>
        <option value="failed">Failed</option>
        <option value="pending">Pending</option>
        <option value="info">Started</option>
      </select>
      <select
        id="type-filter"
        class="rounded-md border-0 bg-white px-3 py-2 text-sm text-slate-900 ring-1 ring-inset ring-slate-200 focus:ring-2 focus:ring-inset focus:ring-emerald-500 focus:outline-none dark:bg-chrome-surface dark:text-chrome-primary dark:ring-white/10"
      >
        <option value="">Promoters + customers</option>
        <option value="promoter">Promoters only</option>
        <option value="customer">Customers only</option>
      </select>
      <span id="row-count" class="text-xs text-slate-400 dark:text-chrome-muted"></span>
    </section>

    <!-- Log table -->
    <section class="overflow-hidden rounded-lg bg-white ring-1 ring-inset ring-slate-200 dark:bg-chrome-surface dark:ring-white/10">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-white/10">
          <thead class="bg-slate-50 dark:bg-white/5">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Time (EAT)</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Subject</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Phone</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Verified by</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Campaign</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-chrome-muted">Status</th>
            </tr>
          </thead>
          <tbody id="log-table-body" class="divide-y divide-slate-100 text-sm dark:divide-white/5">
            <% logs.forEach(function (log) { %>
              <tr data-row-id="<%= log.id %>" data-tone="<%= log.statusTone %>" data-type="<%= log.subjectType %>">
                <td class="tabular whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary"><%= formatEAT(log.createdAt) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-900 dark:text-chrome-primary">
                  <span class="mr-1.5 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-slate-400 dark:bg-white/5 dark:text-chrome-muted"><%= log.subjectType %></span>
                  <%= log.subjectName %>
                </td>
                <td class="tabular whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary"><%= log.maskedPhone %></td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary"><%= log.subjectType === 'customer' ? log.promoterName : '—' %></td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary"><%= log.campaignName %></td>
                <td class="whitespace-nowrap px-4 py-3">
                  <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset <%= toneClasses(log.statusTone) %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= toneDotClasses(log.statusTone) %>"></span>
                    <%= log.statusLabel %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (logs.length === 0) { %>
        <p class="px-4 py-8 text-center text-sm text-slate-400 dark:text-chrome-muted">No verification activity yet.</p>
      <% } %>
    </section>
  </div>

  <script>
    // Keep in sync with toneClasses()/toneDotClasses() in the EJS scriptlet above.
    const TONE_CLASSES = {
      verified: 'bg-emerald-500/10 text-emerald-600 ring-emerald-500/20 dark:text-emerald-400',
      failed: 'bg-red-500/10 text-red-600 ring-red-500/20 dark:text-red-400',
      pending: 'bg-amber-500/10 text-amber-600 ring-amber-500/20 dark:text-amber-400',
      info: 'bg-slate-500/10 text-slate-600 ring-slate-500/20 dark:text-slate-300',
    };
    const TONE_DOT_CLASSES = {
      verified: 'bg-emerald-500 dark:bg-emerald-400',
      failed: 'bg-red-500 dark:bg-red-400',
      pending: 'bg-amber-500 dark:bg-amber-400',
      info: 'bg-slate-400',
    };
    const MAX_ROWS = 50;

    // Keep in sync with the EJS scriptlet's formatEAT() above and
    // server.js's formatEAT() used in exports — all three must agree.
    function formatEAT(dateLike) {
      return new Date(dateLike)
        .toLocaleString('en-GB', {
          timeZone: 'Africa/Addis_Ababa',
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit',
          hour12: false,
        })
        .replace(',', '');
    }

    const tbody = document.getElementById('log-table-body');
    const searchInput = document.getElementById('search-input');
    const statusFilter = document.getElementById('status-filter');
    const typeFilter = document.getElementById('type-filter');
    const rowCountLabel = document.getElementById('row-count');
    const statTotal = document.getElementById('stat-total');
    const statVerified = document.getElementById('stat-verified');
    const statFailed = document.getElementById('stat-failed');
    const statCustomers = document.getElementById('stat-customers');

    // ------------------------------------------------------------------
    // Theme toggle. Preference is stored in localStorage and re-applied
    // instantly on load by the inline script in <head> (before Tailwind
    // renders anything), so there's no flash of the wrong theme.
    // ------------------------------------------------------------------
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle.addEventListener('click', () => {
      const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      document.documentElement.classList.toggle('dark', next === 'dark');
      try { localStorage.setItem('theme', next); } catch (e) {}
    });

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str === null || str === undefined ? '' : String(str);
      return div.innerHTML;
    }

    function buildRow(log) {
      const tr = document.createElement('tr');
      tr.dataset.rowId = log.id;
      tr.dataset.tone = log.statusTone;
      tr.dataset.type = log.subjectType;
      tr.className = 'row-flash';
      const tone = TONE_CLASSES[log.statusTone] || TONE_CLASSES.info;
      const dot = TONE_DOT_CLASSES[log.statusTone] || TONE_DOT_CLASSES.info;
      const verifiedBy = log.subjectType === 'customer' ? escapeHtml(log.promoterName) : '—';
      tr.innerHTML = `
        <td class="tabular whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary">${formatEAT(log.createdAt)}</td>
        <td class="whitespace-nowrap px-4 py-3 text-slate-900 dark:text-chrome-primary">
          <span class="mr-1.5 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-slate-400 dark:bg-white/5 dark:text-chrome-muted">${escapeHtml(log.subjectType)}</span>
          ${escapeHtml(log.subjectName)}
        </td>
        <td class="tabular whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary">${escapeHtml(log.maskedPhone)}</td>
        <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary">${verifiedBy}</td>
        <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-chrome-secondary">${escapeHtml(log.campaignName)}</td>
        <td class="whitespace-nowrap px-4 py-3">
          <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset ${tone}">
            <span class="h-1.5 w-1.5 rounded-full ${dot}"></span>
            ${escapeHtml(log.statusLabel)}
          </span>
        </td>
      `;
      return tr;
    }

    function applyFilters() {
      const searchQuery = searchInput.value.trim().toLowerCase();
      const status = statusFilter.value;
      const type = typeFilter.value;
      let visible = 0;
      for (const row of tbody.rows) {
        const matchesStatus = !status || row.dataset.tone === status;
        const matchesType = !type || row.dataset.type === type;
        const matchesQuery = !searchQuery || row.textContent.toLowerCase().includes(searchQuery);
        const show = matchesStatus && matchesType && matchesQuery;
        row.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }
      rowCountLabel.textContent = `${visible} shown`;
    }

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    typeFilter.addEventListener('change', applyFilters);
    applyFilters();

    function bumpStat(el) {
      const current = parseInt(el.textContent.replace(/,/g, ''), 10) || 0;
      el.textContent = (current + 1).toLocaleString();
    }

    function prependLog(log) {
      const row = buildRow(log);
      tbody.prepend(row);
      while (tbody.rows.length > MAX_ROWS) {
        tbody.deleteRow(tbody.rows.length - 1);
      }
      applyFilters();

      if (log.eventType === 'otp_sent') bumpStat(statTotal);
      if (log.eventType === 'otp_verified') bumpStat(statVerified);
      if (log.eventType === 'otp_failed' || log.eventType === 'otp_expired') bumpStat(statFailed);
      if (log.eventType === 'customer_otp_verified') bumpStat(statCustomers);
    }

    function setConnectionState(state) {
      const dot = document.getElementById('connection-dot');
      const label = document.getElementById('connection-label');
      if (state === 'open') {
        dot.className = 'h-2 w-2 rounded-full bg-emerald-500 dark:bg-emerald-400';
        label.textContent = 'Live';
      } else if (state === 'error') {
        dot.className = 'h-2 w-2 rounded-full bg-red-500 dark:bg-red-400';
        label.textContent = 'Reconnecting…';
      } else {
        dot.className = 'h-2 w-2 rounded-full bg-slate-400 dark:bg-chrome-muted';
        label.textContent = 'Connecting…';
      }
    }

    const source = new EventSource('/api/events/stream');
    source.addEventListener('open', () => setConnectionState('open'));
    source.addEventListener('error', () => setConnectionState('error'));
    source.addEventListener('verification_event', (event) => {
      try {
        const log = JSON.parse(event.data);
        prependLog(log);
      } catch (err) {
        console.error('Failed to parse verification_event payload', err);
      }
    });
  </script>
</body>
</html>
