<%
/**
 * Status-pill class helpers. Kept in sync with TONE_CLASSES / TONE_DOT_CLASSES
 * in the client-side <script> below, which renders the exact same shape of
 * row for live SSE updates — both must map { verified, failed, pending, info }
 * to the same colors (emerald / red / amber / slate) or live rows will visibly
 * mismatch the ones rendered on page load.
 */
function toneClasses(tone) {
  switch (tone) {
    case 'verified': return 'bg-emerald-500/10 text-emerald-400 ring-emerald-500/20';
    case 'failed': return 'bg-red-500/10 text-red-400 ring-red-500/20';
    case 'pending': return 'bg-amber-500/10 text-amber-400 ring-amber-500/20';
    default: return 'bg-slate-500/10 text-slate-300 ring-slate-500/20';
  }
}
function toneDotClasses(tone) {
  switch (tone) {
    case 'verified': return 'bg-emerald-400';
    case 'failed': return 'bg-red-400';
    case 'pending': return 'bg-amber-400';
    default: return 'bg-slate-400';
  }
}
%>
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verification Dashboard — Telegram OTP System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            chrome: {
              plane: '#0d0d0d',
              surface: '#1a1a19',
              primary: '#ffffff',
              secondary: '#c3c2b7',
              muted: '#898781',
            },
          },
        },
      },
    };
  </script>
  <style>
    .tabular { font-variant-numeric: tabular-nums; }
    @keyframes row-flash {
      0% { background-color: rgba(52, 211, 153, 0.16); }
      100% { background-color: transparent; }
    }
    .row-flash { animation: row-flash 1.8s ease-out; }
  </style>
</head>
<body class="h-full bg-chrome-plane text-chrome-primary antialiased">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Header -->
    <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="text-xl font-semibold text-chrome-primary">Promoter Verification Dashboard</h1>
        <p class="mt-1 text-sm text-chrome-secondary">Live verification activity across all campaigns.</p>
      </div>
      <div class="flex items-center gap-3">
        <span id="connection-indicator" class="inline-flex items-center gap-2 rounded-full bg-chrome-surface px-3 py-1.5 text-xs font-medium text-chrome-secondary ring-1 ring-inset ring-white/10">
          <span id="connection-dot" class="h-2 w-2 rounded-full bg-chrome-muted"></span>
          <span id="connection-label">Connecting…</span>
        </span>
        <a
          href="/api/reports/csv"
          class="inline-flex items-center gap-2 rounded-md bg-chrome-surface px-3 py-2 text-sm font-medium text-chrome-primary ring-1 ring-inset ring-white/10 hover:bg-white/5"
        >
          Export Promoters CSV
        </a>
        <a
          href="/api/reports/customers/csv"
          class="inline-flex items-center gap-2 rounded-md bg-chrome-surface px-3 py-2 text-sm font-medium text-chrome-primary ring-1 ring-inset ring-white/10 hover:bg-white/5"
        >
          Export Customers CSV
        </a>
        <a
          href="/api/reports/customers/xlsx"
          class="inline-flex items-center gap-2 rounded-md bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-500"
        >
          Export Customers Excel
        </a>
      </div>
    </header>

    <!-- Stat cards -->
    <section class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg bg-chrome-surface p-5 ring-1 ring-inset ring-white/10">
        <p class="text-sm text-chrome-secondary">Total requests</p>
        <p id="stat-total" class="mt-2 text-3xl font-semibold text-chrome-primary"><%= Number(stats.total_requests || 0).toLocaleString() %></p>
      </div>
      <div class="rounded-lg bg-chrome-surface p-5 ring-1 ring-inset ring-white/10">
        <p class="text-sm text-chrome-secondary">Verified promoters</p>
        <p id="stat-verified" class="mt-2 text-3xl font-semibold text-emerald-400"><%= Number(stats.verified_promoters || 0).toLocaleString() %></p>
      </div>
      <div class="rounded-lg bg-chrome-surface p-5 ring-1 ring-inset ring-white/10">
        <p class="text-sm text-chrome-secondary">Failed OTPs</p>
        <p id="stat-failed" class="mt-2 text-3xl font-semibold text-red-400"><%= Number(stats.failed_otps || 0).toLocaleString() %></p>
      </div>
      <div class="rounded-lg bg-chrome-surface p-5 ring-1 ring-inset ring-white/10">
        <p class="text-sm text-chrome-secondary">Verified customers</p>
        <p id="stat-customers" class="mt-2 text-3xl font-semibold text-emerald-400"><%= Number(stats.verified_customers || 0).toLocaleString() %></p>
      </div>
    </section>

    <!-- Filters -->
    <section class="mb-4 flex flex-wrap items-center gap-3">
      <input
        id="search-input"
        type="text"
        placeholder="Search by name, phone, campaign…"
        class="w-full max-w-sm rounded-md border-0 bg-chrome-surface px-3 py-2 text-sm text-chrome-primary placeholder:text-chrome-muted ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-emerald-500 focus:outline-none"
      />
      <select
        id="status-filter"
        class="rounded-md border-0 bg-chrome-surface px-3 py-2 text-sm text-chrome-primary ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-emerald-500 focus:outline-none"
      >
        <option value="">All statuses</option>
        <option value="verified">Verified</option>
        <option value="failed">Failed</option>
        <option value="pending">Pending</option>
        <option value="info">Started</option>
      </select>
      <select
        id="type-filter"
        class="rounded-md border-0 bg-chrome-surface px-3 py-2 text-sm text-chrome-primary ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-emerald-500 focus:outline-none"
      >
        <option value="">Promoters + customers</option>
        <option value="promoter">Promoters only</option>
        <option value="customer">Customers only</option>
      </select>
      <span id="row-count" class="text-xs text-chrome-muted"></span>
    </section>

    <!-- Log table -->
    <section class="overflow-hidden rounded-lg bg-chrome-surface ring-1 ring-inset ring-white/10">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-white/10">
          <thead class="bg-white/5">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Time</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Subject</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Phone</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Verified by</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Campaign</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Status</th>
            </tr>
          </thead>
          <tbody id="log-table-body" class="divide-y divide-white/5 text-sm">
            <% logs.forEach(function (log) { %>
              <tr data-row-id="<%= log.id %>" data-tone="<%= log.statusTone %>" data-type="<%= log.subjectType %>">
                <td class="tabular whitespace-nowrap px-4 py-3 text-chrome-secondary"><%= new Date(log.createdAt).toLocaleString() %></td>
                <td class="whitespace-nowrap px-4 py-3 text-chrome-primary">
                  <span class="mr-1.5 rounded bg-white/5 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-chrome-muted"><%= log.subjectType %></span>
                  <%= log.subjectName %>
                </td>
                <td class="tabular whitespace-nowrap px-4 py-3 text-chrome-secondary"><%= log.maskedPhone %></td>
                <td class="whitespace-nowrap px-4 py-3 text-chrome-secondary"><%= log.subjectType === 'customer' ? log.promoterName : '—' %></td>
                <td class="whitespace-nowrap px-4 py-3 text-chrome-secondary"><%= log.campaignName %></td>
                <td class="whitespace-nowrap px-4 py-3">
                  <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset <%= toneClasses(log.statusTone) %>">
                    <span class="h-1.5 w-1.5 rounded-full <%= toneDotClasses(log.statusTone) %>"></span>
                    <%= log.statusLabel %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (logs.length === 0) { %>
        <p class="px-4 py-8 text-center text-sm text-chrome-muted">No verification activity yet.</p>
      <% } %>
    </section>

    <!-- Promoter leaderboard: how many customers each promoter has registered -->
    <section class="mt-8 overflow-hidden rounded-lg bg-chrome-surface ring-1 ring-inset ring-white/10">
      <div class="border-b border-white/10 px-4 py-3">
        <h2 class="text-sm font-semibold text-chrome-primary">Customers registered per promoter</h2>
        <p class="mt-0.5 text-xs text-chrome-muted">Sorted by verified customers. Download a promoter's full customer list as CSV.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-white/10">
          <thead class="bg-white/5">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Promoter</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">City</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">Campaign</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-chrome-muted">Customers contacted</th>
              <th scope="col" class="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-chrome-muted">Customers verified</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium uppercase tracking-wide text-chrome-muted">List</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-sm">
            <% promoterLeaderboard.forEach(function (row) { %>
              <tr>
                <td class="whitespace-nowrap px-4 py-3 text-chrome-primary"><%= row.full_name || row.telegram_username || ('Promoter #' + row.id) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-chrome-secondary"><%= row.city || '—' %></td>
                <td class="whitespace-nowrap px-4 py-3 text-chrome-secondary"><%= row.campaign_name || '—' %></td>
                <td class="tabular whitespace-nowrap px-4 py-3 text-right text-chrome-secondary"><%= row.customers_contacted %></td>
                <td class="tabular whitespace-nowrap px-4 py-3 text-right text-emerald-400"><%= row.customers_verified %></td>
                <td class="whitespace-nowrap px-4 py-3">
                  <a href="/api/promoters/<%= row.id %>/customers/csv" class="text-xs font-medium text-chrome-primary underline decoration-white/30 hover:decoration-white/70">
                    Download CSV
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (promoterLeaderboard.length === 0) { %>
        <p class="px-4 py-8 text-center text-sm text-chrome-muted">No promoter has registered any customers yet.</p>
      <% } %>
    </section>
  </div>

  <script>
    // Keep in sync with toneClasses()/toneDotClasses() in the EJS scriptlet above.
    const TONE_CLASSES = {
      verified: 'bg-emerald-500/10 text-emerald-400 ring-emerald-500/20',
      failed: 'bg-red-500/10 text-red-400 ring-red-500/20',
      pending: 'bg-amber-500/10 text-amber-400 ring-amber-500/20',
      info: 'bg-slate-500/10 text-slate-300 ring-slate-500/20',
    };
    const TONE_DOT_CLASSES = {
      verified: 'bg-emerald-400',
      failed: 'bg-red-400',
      pending: 'bg-amber-400',
      info: 'bg-slate-400',
    };
    const MAX_ROWS = 50;

    const tbody = document.getElementById('log-table-body');
    const searchInput = document.getElementById('search-input');
    const statusFilter = document.getElementById('status-filter');
    const typeFilter = document.getElementById('type-filter');
    const rowCountLabel = document.getElementById('row-count');
    const statTotal = document.getElementById('stat-total');
    const statVerified = document.getElementById('stat-verified');
    const statFailed = document.getElementById('stat-failed');
    const statCustomers = document.getElementById('stat-customers');

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str === null || str === undefined ? '' : String(str);
      return div.innerHTML;
    }

    function buildRow(log) {
      const tr = document.createElement('tr');
      tr.dataset.rowId = log.id;
      tr.dataset.tone = log.statusTone;
      tr.dataset.type = log.subjectType;
      tr.className = 'row-flash';
      const tone = TONE_CLASSES[log.statusTone] || TONE_CLASSES.info;
      const dot = TONE_DOT_CLASSES[log.statusTone] || TONE_DOT_CLASSES.info;
      const verifiedBy = log.subjectType === 'customer' ? escapeHtml(log.promoterName) : '—';
      tr.innerHTML = `
        <td class="tabular whitespace-nowrap px-4 py-3 text-chrome-secondary">${new Date(log.createdAt).toLocaleString()}</td>
        <td class="whitespace-nowrap px-4 py-3 text-chrome-primary">
          <span class="mr-1.5 rounded bg-white/5 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-chrome-muted">${escapeHtml(log.subjectType)}</span>
          ${escapeHtml(log.subjectName)}
        </td>
        <td class="tabular whitespace-nowrap px-4 py-3 text-chrome-secondary">${escapeHtml(log.maskedPhone)}</td>
        <td class="whitespace-nowrap px-4 py-3 text-chrome-secondary">${verifiedBy}</td>
        <td class="whitespace-nowrap px-4 py-3 text-chrome-secondary">${escapeHtml(log.campaignName)}</td>
        <td class="whitespace-nowrap px-4 py-3">
          <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset ${tone}">
            <span class="h-1.5 w-1.5 rounded-full ${dot}"></span>
            ${escapeHtml(log.statusLabel)}
          </span>
        </td>
      `;
      return tr;
    }

    function applyFilters() {
      const searchQuery = searchInput.value.trim().toLowerCase();
      const status = statusFilter.value;
      const type = typeFilter.value;
      let visible = 0;
      for (const row of tbody.rows) {
        const matchesStatus = !status || row.dataset.tone === status;
        const matchesType = !type || row.dataset.type === type;
        const matchesQuery = !searchQuery || row.textContent.toLowerCase().includes(searchQuery);
        const show = matchesStatus && matchesType && matchesQuery;
        row.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }
      rowCountLabel.textContent = `${visible} shown`;
    }

    searchInput.addEventListener('input', applyFilters);
    statusFilter.addEventListener('change', applyFilters);
    typeFilter.addEventListener('change', applyFilters);
    applyFilters();

    function bumpStat(el) {
      const current = parseInt(el.textContent.replace(/,/g, ''), 10) || 0;
      el.textContent = (current + 1).toLocaleString();
    }

    function prependLog(log) {
      const row = buildRow(log);
      tbody.prepend(row);
      while (tbody.rows.length > MAX_ROWS) {
        tbody.deleteRow(tbody.rows.length - 1);
      }
      applyFilters();

      if (log.eventType === 'otp_sent') bumpStat(statTotal);
      if (log.eventType === 'otp_verified') bumpStat(statVerified);
      if (log.eventType === 'otp_failed' || log.eventType === 'otp_expired') bumpStat(statFailed);
      if (log.eventType === 'customer_otp_verified') bumpStat(statCustomers);
    }

    function setConnectionState(state) {
      const dot = document.getElementById('connection-dot');
      const label = document.getElementById('connection-label');
      if (state === 'open') {
        dot.className = 'h-2 w-2 rounded-full bg-emerald-400';
        label.textContent = 'Live';
      } else if (state === 'error') {
        dot.className = 'h-2 w-2 rounded-full bg-red-400';
        label.textContent = 'Reconnecting…';
      } else {
        dot.className = 'h-2 w-2 rounded-full bg-chrome-muted';
        label.textContent = 'Connecting…';
      }
    }

    const source = new EventSource('/api/events/stream');
    source.addEventListener('open', () => setConnectionState('open'));
    source.addEventListener('error', () => setConnectionState('error'));
    source.addEventListener('verification_event', (event) => {
      try {
        const log = JSON.parse(event.data);
        prependLog(log);
      } catch (err) {
        console.error('Failed to parse verification_event payload', err);
      }
    });
  </script>
</body>
</html>
