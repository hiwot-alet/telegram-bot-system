# Copy to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Admin login (gates the whole dashboard)
ADMIN_USERNAME=admin
# bcrypt hash of the login password — never put the plaintext password here.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=
# Long random string used to sign the session cookie, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
PORT=3000
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
DATABASE_SSL=false
DB_LOG_QUERIES=false
